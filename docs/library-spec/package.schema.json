{
  "type": "object",
  "properties": {
    "format_version": {
      "const": "probe-techpack/1"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 512
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "technique_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 97,
            "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,63}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "technique_id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "technique_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 97,
            "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,63}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "files": {
            "type": "object",
            "minProperties": 4,
            "maxProperties": 32,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65536
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "bytes",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "technique_id",
          "revision",
          "path",
          "files"
        ],
        "additionalProperties": false
      }
    },
    "external_dependencies": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 169
      }
    },
    "self_contained": {
      "type": "boolean"
    }
  },
  "required": [
    "format_version",
    "package_id",
    "title",
    "summary",
    "roots",
    "entries",
    "external_dependencies",
    "self_contained"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
