{
  "type": "object",
  "properties": {
    "format_version": {
      "const": "probe-report/1"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "metrics": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": [
          "number",
          "boolean",
          "string",
          "null",
          "array",
          "object"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "node": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "format_version",
    "summary",
    "metrics",
    "findings"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
