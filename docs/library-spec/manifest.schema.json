{
  "type": "object",
  "properties": {
    "format_version": {
      "const": "probe-technique/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "minItems": 0,
      "maxItems": 16
    },
    "kind": {
      "type": "string",
      "enum": [
        "generator",
        "analyzer",
        "calculator"
      ]
    },
    "entrypoint": {
      "const": "technique.js"
    },
    "input_schema": {
      "const": "inputs.schema.json"
    },
    "tests": {
      "const": "tests.json"
    },
    "runtime": {
      "const": "probe-js/1"
    },
    "output": {
      "type": "string",
      "enum": [
        "sketchup-plan/1",
        "probe-report/1"
      ]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*/[1-9][0-9]*$"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "material_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "technique_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,63}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "alias",
          "technique_id",
          "revision"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "query": {
            "type": "string",
            "enum": [
              "target-summary/1",
              "target-subtree/1"
            ]
          },
          "binding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "max_entities": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048
          }
        },
        "required": [
          "name",
          "query",
          "binding",
          "max_entities"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 4
    },
    "budgets": {
      "type": "object",
      "properties": {
        "plan_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 16,
          "maximum": 256
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_points": {
          "type": "integer",
          "minimum": 4,
          "maximum": 4096
        },
        "max_faces": {
          "type": "integer",
          "minimum": 4,
          "maximum": 2048
        },
        "max_plan_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 48000
        }
      },
      "required": [
        "plan_ms",
        "memory_mib",
        "max_nodes",
        "max_points",
        "max_faces",
        "max_plan_bytes"
      ],
      "additionalProperties": false
    },
    "helpers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "path": {
            "type": "string",
            "pattern": "^helpers/[a-z][a-z0-9_-]{0,47}\\.js$"
          }
        },
        "required": [
          "alias",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format_version",
    "id",
    "title",
    "summary",
    "kind",
    "entrypoint",
    "input_schema",
    "tests",
    "runtime",
    "output",
    "requires",
    "material_roles",
    "dependencies",
    "reads",
    "budgets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probe technique manifest v1 (design draft; not an installed runtime contract)"
}
