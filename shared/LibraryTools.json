{
  "sketchup_library_list": {
    "description": "List libraries or search techniques without a SketchUp connection. Compact summaries, revision-bound cursors. Use state=all to include drafts. No source code in list.",
    "schema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "libraries",
            "techniques"
          ]
        },
        "library_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "maxItems": 16
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "all"
          ]
        },
        "compatible_with": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "model_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "required": [
            "session_id",
            "model_id"
          ],
          "additionalProperties": false
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "sketchup_library_get": {
