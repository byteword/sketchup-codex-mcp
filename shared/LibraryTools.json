  "sketchup_library_save": {
    "description": "Save complete UTF-8 technique file snapshot as an immutable draft. base_revision=null creates; otherwise compare with current head. request_id deduplicates. Does not activate or touch model.",
    "schema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "library_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "technique_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 97,
          "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,63}$"
        },
        "base_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "change_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "derived_from": {
          "type": "object",
          "properties": {
            "library_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "technique_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 97,
              "pattern": "^[a-z][a-z0-9-]{0,31}\\.[a-z][a-z0-9-]{0,63}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 71,
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "library_id",
            "technique_id",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "request_id",
        "technique_id",
        "base_revision",
        "files",
        "change_summary"
      ],
      "additionalProperties": false
    }
  },
