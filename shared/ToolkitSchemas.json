{
  "sketchup_get_resources": {
    "description": "Read paged materials, tags, component definitions or camera scenes. Exact names/IDs; no permission required. Pages are live; restart after edits. No texture file contents.",
    "read": true,
    "schema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "materials",
            "tags",
            "definitions",
            "scenes"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "session_id",
        "model_id",
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "sketchup_manage_resource": {
    "description": "Create/update/delete solid-color materials or tags, or purge unused definitions/materials/tags. Tag deletion preserves geometry and reassigns it to Layer0. Layer0 and active tag cannot be deleted. Purge is model-wide and requires confirm_model_wide=true. No texture file access.",
    "read": false,
    "schema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}:[1-9][0-9]{0,9}$",
          "maxLength": 48
        },
        "expected_context": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19
          },
          "minItems": 0,
          "maxItems": 32
        },
        "dry_run": {
          "type": "boolean"
        },
        "ui_updates": {
          "type": "string",
          "enum": [
            "defer",
            "normal"
          ],
          "default": "defer",
          "description": "Native model operations only: defer suppresses intermediate UI/Outliner updates and requests one refresh after commit/abort. normal allows normal updates. No persistent freeze/tray visibility changes. Not applicable to camera/scenes."
        },
        "kind": {
          "type": "string",
          "enum": [
            "materials",
            "tags",
            "definitions"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "purge_unused"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "new_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color_rgb": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 3,
              "maxItems": 3
            },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "confirm_model_wide": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "model_id",
        "command_id",
        "expected_context",
        "kind",
        "action",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "sketchup_component": {
    "description": "Convert groups to components, explode explicit groups/components, replace component definitions, create instances of an existing definition, or update definition name/description. Definition metadata affects all occurrences. Recursive definitions and glued targets are rejected; shared edits require explicit affect_all_instances=true. Required options: convert/explode: entity_ids; replace: entity_ids,definition_id; instantiate: definition_id,origin_mm; metadata: definition_id,affect_all_instances=true plus name/description. definition_id is a model-session-local definition:<entityID> returned by get_resources/get_entity_info, not a drawing persistent ID. Query fresh after model switching.",
    "read": false,
    "schema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}:[1-9][0-9]{0,9}$",
          "maxLength": 48
        },
        "expected_context": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19
          },
          "minItems": 0,
          "maxItems": 32
        },
        "dry_run": {
          "type": "boolean"
        },
        "ui_updates": {
          "type": "string",
          "enum": [
            "defer",
            "normal"
          ],
          "default": "defer",
          "description": "Native model operations only: defer suppresses intermediate UI/Outliner updates and requests one refresh after commit/abort. normal allows normal updates. No persistent freeze/tray visibility changes. Not applicable to camera/scenes."
        },
        "action": {
          "type": "string",
          "enum": [
            "convert",
            "explode",
            "replace",
            "instantiate",
            "metadata"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "entity_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "maxLength": 19
              },
              "minItems": 1,
              "maxItems": 25
            },
            "definition_id": {
              "type": "string",
              "pattern": "^definition:[1-9][0-9]{0,18}$",
              "maxLength": 30
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "description": {
              "type": "string",
              "maxLength": 1024
            },
            "origin_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "affect_all_instances": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "model_id",
        "command_id",
        "expected_context",
        "action",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "sketchup_create_geometry": {
    "description": "Create isolated geometry in a new group using model-axis mm: construction points, planar face, regular polygon, center/two-point(ends+signed bulge)/three-point arc, Bezier or freehand curve, closed oriented indexed polyhedron, convex planar polygon offset, revolution or Follow Me sweep. Precision is segments (3..128); no holes or self-intersecting profiles. See options required by each kind in docs/EXTENDED_TOOLKIT.md. Required options: points/face/freehand: points_mm; polygon: origin_mm,plane,radius_mm,sides; arc_center: origin_mm,plane,radius_mm,start_degrees,sweep_degrees; arc_two_point: points_mm=[start,end],plane,bulge_mm; arc_three_point: points_mm=[start,through,end]; bezier: points_mm(2..16 controls); polyhedron: points_mm,faces(index loops); offset: points_mm,distance_mm(positive outward); revolve: points_mm(closed profile),pivot_mm,axis,sweep_degrees; sweep: points_mm(closed profile),path_mm(start on profile plane, first segment normal). Optional segments for arcs/Bezier/revolve, default24. Mesh budget256 faces/2048 indexed corners.",
    "read": false,
    "schema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}:[1-9][0-9]{0,9}$",
          "maxLength": 48
        },
        "expected_context": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19
          },
          "minItems": 0,
          "maxItems": 32
        },
        "dry_run": {
          "type": "boolean"
        },
        "ui_updates": {
          "type": "string",
          "enum": [
            "defer",
            "normal"
          ],
          "default": "defer",
          "description": "Native model operations only: defer suppresses intermediate UI/Outliner updates and requests one refresh after commit/abort. normal allows normal updates. No persistent freeze/tray visibility changes. Not applicable to camera/scenes."
        },
        "kind": {
          "type": "string",
          "enum": [
            "points",
            "face",
            "polygon",
            "arc_center",
            "arc_two_point",
            "arc_three_point",
            "bezier",
            "freehand",
            "polyhedron",
            "offset",
            "revolve",
            "sweep"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "options": {
          "type": "object",
          "properties": {
            "points_mm": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 1,
              "maxItems": 256
            },
            "faces": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 64
              },
              "minItems": 4,
              "maxItems": 256
            },
            "origin_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "plane": {
              "type": "string",
              "enum": [
                "XY",
                "XZ",
                "YZ"
              ]
            },
            "radius_mm": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000000
            },
            "sides": {
              "type": "integer",
              "minimum": 3,
              "maximum": 128
            },
            "segments": {
              "type": "integer",
              "minimum": 3,
              "maximum": 128
            },
            "start_degrees": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "sweep_degrees": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "bulge_mm": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "distance_mm": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            },
            "pivot_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "axis": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "path_mm": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 2,
              "maxItems": 64
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "model_id",
        "command_id",
        "expected_context",
        "kind",
        "name",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "sketchup_edit_geometry": {
    "description": "Edit explicit raw children of one direct group/component. Unique definition required, or explicit affect_all_instances=true for shared components; this edits their definition for all occurrences. Shared groups still require make_unique. Add points/lines/faces, erase raw items, move construction points or edge endpoints, regenerate bounded faces, reverse faces, assign front/back materials, soften/smooth or unsoften edges, dissolve only coplanar internal edges. Edge deletion can remove adjacent faces. IDs/paths become stale after topology edits. No implicit edit-context changes. Required options: add_points/add_lines/add_face: points_mm; move_vertices: vertex_moves(edge_id,endpoint=start/end,position_mm); others: entity_ids. move_points also delta_mm. properties: material/back_material(null clears),hidden. soften: optional angle_degrees default30, only two-face edges within angle. simplify: only untextured matching coplanar face pairs; verifies total area.",
    "read": false,
    "schema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        },
        "model_id": {
          "type": "string",
          "format": "uuid"
        },
        "command_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}:[1-9][0-9]{0,9}$",
          "maxLength": 48
        },
        "expected_context": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19
          },
          "minItems": 0,
          "maxItems": 32
        },
        "dry_run": {
          "type": "boolean"
        },
        "ui_updates": {
          "type": "string",
          "enum": [
            "defer",
            "normal"
          ],
          "default": "defer",
          "description": "Native model operations only: defer suppresses intermediate UI/Outliner updates and requests one refresh after commit/abort. normal allows normal updates. No persistent freeze/tray visibility changes. Not applicable to camera/scenes."
        },
        "container_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "maxLength": 19
        },
        "affect_all_instances": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "add_points",
            "add_lines",
            "add_face",
            "erase",
            "move_points",
            "move_vertices",
            "rebuild_faces",
            "reverse_faces",
            "properties",
            "soften",
            "unsoften",
            "simplify"
          ]
        },
        "options": {
          "type": "object",
          "properties": {
            "entity_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "maxLength": 19
              },
              "minItems": 1,
              "maxItems": 128
            },
            "points_mm": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 1,
              "maxItems": 256
            },
            "delta_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 3,
              "maxItems": 3
            },
            "vertex_moves": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "edge_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$",
                    "maxLength": 19
                  },
                  "endpoint": {
                    "type": "string",
                    "enum": [
                      "start",
                      "end"
                    ]
                  },
                  "position_mm": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -1000000000.0,
                      "maximum": 1000000000.0
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "edge_id",
                  "endpoint",
                  "position_mm"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 64
            },
            "material": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "back_material": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "hidden": {
              "type": "boolean"
            },
            "angle_degrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "session_id",
        "model_id",
        "command_id",
        "expected_context",
        "container_id",
        "action",
        "options"
      ],
      "additionalProperties": false
    }
  },
